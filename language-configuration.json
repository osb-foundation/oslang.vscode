{
  "comments": {
    "lineComment": "'",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "{", "close": "}", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    { "open": "'", "close": "'" },
    { "open": "\"", "close": "\"" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" }
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(CLASS|INTERFACE|FUNCTION|CONSTRUCTOR|IF|ELIF|ELSE|FOR|WHILE|DO|TRY|CATCH|SWITCH|CASE|DEFAULT|ENUM)\\b",
    "decreaseIndentPattern": "^\\s*END\\b"
  }
}
