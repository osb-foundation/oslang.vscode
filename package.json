{
  "name": "oslang",
  "displayName": "OSLANG",
  "description": "Syntax highlighting, editor configuration, and language support for OSLANG 0.8, the scripting language of OSB. Visual Studio Code and VSCodium.",
  "version": "0.1.1",
  "publisher": "osb-foundation",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "oslang",
    "osb",
    "scripting",
    "syntax-highlighting",
    "language-support"
  ],
  "contributes": {
    "languages": [
      {
        "id": "oslang",
        "aliases": [
          "OSLANG",
          "oslang"
        ],
        "extensions": [
          ".osl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oslang",
        "scopeName": "source.oslang",
        "path": "./syntaxes/oslang.tmLanguage.json"
      }
    ],
    "completionProvider": []
  },
  "author": {
    "name": "OSB Project"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ygorlazaro/osb-dotnet"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ygorlazaro/osb-dotnet/issues"
  },
  "scripts": {
    "test": "node test/tokenize.js && node test/completion.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^7.0.4"
  },
  "main": "extension.js",
  "activationEvents": [
    "onLanguage:oslang"
  ]
}