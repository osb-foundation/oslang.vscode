{
  "scopeName": "source.oslang",
  "name": "OSLANG 0.8",
  "fileTypes": [
    ".osl"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#datetimes" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.oslang",
          "match": "'[^\\n]*"
        },
        {
          "name": "comment.line.rem.oslang",
          "match": "\\bREM\\b[^\\n]*"
        },
        {
          "name": "comment.block.oslang",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.oslang",
          "begin": "\"",
          "end": "\"(?!\")",
          "patterns": [
            {
              "name": "constant.character.escape.oslang",
              "match": "\\\\([nt\\\\\"])"
            },
            {
              "name": "constant.character.escape.oslang",
              "match": "\"\""
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.number.oslang",
          "match": "\\b\\d+(?:\\.\\d+)?"
        }
      ]
    },
    "datetimes": {
      "patterns": [
        {
          "name": "constant.numeric.date.oslang",
          "match": "#\\d{4}-\\d{2}-\\d{2}#"
        },
        {
          "name": "constant.numeric.time.oslang",
          "match": "#\\d{2}:\\d{2}:\\d{2}#"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.oslang",
          "match": "(?i)\\b(BOOLEAN|BOOL|NUMBER|STRING|OBJECT)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.oslang",
          "match": "(?i)\\b(AND|BREAK|CATCH|CONTINUE|DO|ELIF|ELSE|END|FOR|IF|NOT|OR|RETURN|STEP|THEN|TO|WHILE|TRY|SWITCH|CASE|DEFAULT|RAISE|ON)\\b"
        },
        {
          "name": "keyword.declaration.oslang",
          "match": "(?i)\\b(CONSTRUCTOR|FUNCTION|CLASS|INTERFACE|VAR|GLOBAL|USING|EVENT|ENUM)\\b"
        },
        {
          "name": "storage.modifier.oslang",
          "match": "(?i)\\b(PUBLIC|PRIVATE|PROTECTED|VIRTUAL|OVERRIDE)\\b"
        },
        {
          "name": "keyword.other.oslang",
          "match": "(?i)\\b(BASE|ME|NEW|PRINT|INPUT|CLEAR|SHOW|MATH|FILE|DIR|DATE|TIME|TYPEOF|STR|SQRT|POW|FLOOR|CEIL|COUNT|OSL|OSB|IN|EACH)\\b"
        },
        {
          "name": "constant.language.oslang",
          "match": "(?i)\\b(TRUE|FALSE|null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.oslang",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.arithmetic.oslang",
          "match": "\\+\\+|--|\\+=|\\*\\*|%|\\*|-|\\+|/|\\||\\bMOD\\b"
        },
        {
          "name": "keyword.operator.comparison.oslang",
          "match": "==|<>|<=|>=|<|>|="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.oslang",
          "match": "\\(|\\)|\\[|\\]|\\{|\\}|,|:|\\."
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.identifier.oslang",
          "match": "[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    }
  }
}
