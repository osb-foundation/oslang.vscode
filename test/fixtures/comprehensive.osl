REM OSLANG 0.8 comprehensive lexical fixture
' Line comment containing keywords: FUNCTION IF THEN END FOR VAR CLASS
USING OSL.CONSOLE

VAR myCount
VAR age NUMBER
VAR name STRING
myCount = 42
pi = 3.14
flag = TRUE
valid = flag AND NOT empty
mod = 10 % 3
empty = NULL
message = "Hello, OSLANG!"
escaped = "Quote ""doubled"" and \n newline"
today = #2026-11-26#
now = #14:30:45#

IF myCount > 0 THEN
    PRINT "positive"
ELIF myCount < 0 THEN
    PRINT "negative"
ELSE
    PRINT "zero"
END

FOR i = 1 TO 10 STEP 1
    PRINT i
END

WHILE myCount > 0
    myCount = myCount - 1
END

DO
    PRINT "once"
WHILE FALSE

SWITCH day
    CASE 1
        PRINT "one"
    DEFAULT
        PRINT "other"
END

TRY
    x = 1 / 0
CATCH err
    PRINT err
END

RAISE "failure"

FUNCTION Add(a, b)
    RETURN a + b
END FUNCTION

CLASS Point
    PUBLIC X
    PRIVATE Y
    CONSTRUCTOR(x, y)
        ME.X = x
        BASE()
    END CONSTRUCTOR
    FUNCTION Move(dx, dy)
        ME.X = ME.X + dx
        VIRTUAL
        OVERRIDE
    END FUNCTION
END CLASS

ENUM Color
    RED
    GREEN
    BLUE
END

combined = Color.RED | Color.GREEN
power = 2 ** 8
rem = 10 MOD 3
counter = 0
counter++
counter--
total += 5
arrow = a => b
other = c -> d
OSL.CONSOLE.WRITE("hello")
MATH.SQRT(16)
STR(x)
TYPEOF(x)

NOTHING = 2
FUNCTIONAL = 1
COUNTDOWN = 3
STRING_WITH_KEYWORD = "FUNCTION THEN END NOTHING COUNT"
